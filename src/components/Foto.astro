---
// Imagem com fundo de reserva: se o arquivo ainda não existir, fica o degradê.
interface Props {
  src: string;
  alt: string;
  class?: string;
  eager?: boolean;
  largura?: number;
  altura?: number;
  sizes?: string;
  [key: string]: any;
}
const { src, alt, class: cls = '', eager = false, largura = 1600, altura = 1200, ...rest } = Astro.props;
---
<div class:list={['foto img-ph', cls]} {...rest}>
  <img
    src={src}
    alt={alt}
    width={largura}
    height={altura}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
    onerror="this.style.visibility='hidden'"
  />
</div>
<style>
  .foto { position: relative; overflow: hidden; }
  .foto img { width: 100%; height: 100%; object-fit: cover; }
</style>
