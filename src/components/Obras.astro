---
import { obras, atualizadoEm } from '../data/obras';
---
<section class="obras secao escura" id="obras">
  <div class="container">
    <div class="obras-topo">
      <p class="eyebrow" data-reveal>Andamento das obras</p>
      <h2 data-reveal>O Gran Lago ganhando forma</h2>
      {atualizadoEm !== 'CONFIRMAR' && <p class="lead" data-reveal>Atualizado em {atualizadoEm}.</p>}
    </div>
    <div class="obras-lista">
      {obras.map((e) => (
        <section class="obras-etapa" data-reveal>
          <h3>{e.etapa}</h3>
          <ul>
            {e.itens.map((it) => (
              <li>
                <span class="obras-nome">{it.nome}</span>
                {it.percentual !== null ? (
                  <span class="obras-pct">
                    <span class="obras-barra" aria-hidden="true"><span data-progresso style={`--p:${it.percentual / 100}`}></span></span>
                    {it.percentual === 100 ? 'Concluído' : `${it.percentual}%`}
                  </span>
                ) : (
                  <span class="obras-prazo">Previsão {it.prazo}</span>
                )}
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .obras-topo { display: grid; gap: 16px; margin-bottom: clamp(40px, 5vw, 64px); }
  .obras-lista { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(28px, 4vw, 56px) clamp(24px, 3vw, 48px); }
  .obras-etapa h3 { padding-bottom: 14px; margin-bottom: 6px; border-bottom: 1px solid var(--line); }
  .obras-etapa ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .obras-etapa li { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 8px 0; font-size: 0.95rem; }
  .obras-prazo { color: var(--fg-soft); font-size: 0.84rem; white-space: nowrap; }
  .obras-pct { font-variant-numeric: tabular-nums; display: inline-flex; align-items: center; gap: 10px; color: var(--acento-texto); font-size: 0.84rem; font-weight: 600; white-space: nowrap; }
  .obras-barra { width: 48px; height: 3px; }
  .obras-barra span { display: block; height: 100%; border-radius: 3px; background: currentColor; transform-origin: left; transform: scaleX(var(--p)); }
  @media (max-width: 1000px) { .obras-lista { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .obras-lista { grid-template-columns: 1fr; } }
</style>
