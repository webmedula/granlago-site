---
import { obras, atualizadoEm } from '../data/obras';
const etapas = obras;
---
<section class="obras secao escura" id="obras">
  <div class="container">
    <div class="obras-topo">
      <p class="eyebrow" data-reveal>Acompanhe as obras</p>
      <h2 data-reveal>O Gran Lago ganhando forma</h2>
      {atualizadoEm !== 'CONFIRMAR' && <p class="lead" data-reveal>Atualizado em {atualizadoEm}.</p>}
    </div>
    <ol class="obras-lista">
      {etapas.map((e, i) => (
        <li class="obras-etapa" data-reveal>
          <div class="obras-etapa-cab">
            <span class="obras-n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{e.etapa}</h3>
          </div>
          <ul>
            {e.itens.map((it) => (
              <li class="obras-item">
                <div class="obras-linha">
                  <span>{it.nome}</span>
                  <span class="obras-prazo">{it.percentual === 100 ? 'Concluído' : `Previsão ${it.prazo}`}</span>
                </div>
                {it.percentual !== null && (
                  <div class="obras-barra" role="progressbar" aria-valuenow={it.percentual} aria-valuemin="0" aria-valuemax="100" aria-label={it.nome}>
                    <span data-progresso={it.percentual} style={`--p:${it.percentual / 100}`}></span>
                    <em>{it.percentual}%</em>
                  </div>
                )}
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .obras-topo { display: grid; gap: 18px; margin-bottom: clamp(40px, 6vw, 72px); }
  .obras-lista { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .obras-etapa { background: rgba(243,238,228,0.04); border: 1px solid rgba(243,238,228,0.1); border-radius: var(--raio); padding: 28px; }
  .obras-etapa-cab { display: flex; align-items: baseline; gap: 14px; margin-bottom: 18px; }
  .obras-n { font-size: 0.8rem; font-weight: 700; color: var(--ouro-claro); letter-spacing: 0.1em; }
  .obras-etapa ul { list-style: none; margin: 0; padding: 0; display: grid; }
  .obras-item { padding: 12px 0; border-top: 1px solid rgba(243,238,228,0.1); display: grid; gap: 8px; }
  .obras-linha { display: flex; justify-content: space-between; gap: 16px; font-size: 0.95rem; }
  .obras-prazo { color: rgba(243,238,228,0.6); font-size: 0.82rem; white-space: nowrap; }
  .obras-barra { position: relative; height: 4px; background: rgba(243,238,228,0.12); border-radius: 4px; }
  .obras-barra span { position: absolute; inset: 0; background: var(--ouro); border-radius: 4px; transform-origin: left; transform: scaleX(var(--p)); }
  .obras-barra em { position: absolute; right: 0; top: 8px; font-style: normal; font-size: 0.75rem; color: var(--ouro-claro); }
  @media (max-width: 900px) { .obras-lista { grid-template-columns: 1fr; } .obras-etapa { padding: 22px; } }
</style>
