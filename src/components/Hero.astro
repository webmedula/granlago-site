---
import { destaques, site } from '../data/site';
import Icone from './Icone.astro';
const wa = `https://wa.me/${site.contato.whatsapp}?text=${encodeURIComponent(site.contato.whatsappMensagem)}`;
---
<section class="hero" data-hero>
  <div class="hero-midia img-ph" data-hero-midia>
    <!-- Troque por um vídeo aéreo (hero.mp4) quando houver: <video autoplay muted loop playsinline poster="/img/hero.webp" src="/img/hero.mp4"></video> -->
    <img src="/img/hero.webp" alt="" fetchpriority="high" onerror="this.style.visibility='hidden'" />
  </div>
  <div class="hero-veu"></div>

  <div class="hero-conteudo container">
    <p class="eyebrow hero-eyebrow" data-hero-item>GO-020 · Goiânia</p>
    <h1 class="hero-titulo" data-split>
      Viver à beira do lago, cercado pela natureza
    </h1>
    <p class="hero-texto" data-hero-item>
      Um condomínio horizontal com paisagismo biofílico e mais de 40 itens de lazer, no eixo que mais valoriza em Goiânia.
    </p>
    <div class="hero-acoes" data-hero-item>
      <a class="botao" href={wa} target="_blank" rel="noopener" data-evento="whatsapp_hero"><Icone nome="whatsapp" /> Falar com um consultor</a>
      <a class="botao contorno" href={site.links.simulador} target="_blank" rel="noopener" data-evento="simulador_hero"><Icone nome="calculadora" /> Simular parcelas</a>
    </div>
  </div>

  <ul class="hero-numeros container" data-hero-item>
    {destaques.map((d) => (
      <li>
        <strong><span>{d.prefixo}</span><span data-contador={d.valor}>{d.valor}</span><span>{d.sufixo}</span></strong>
        <span>{d.rotulo}</span>
      </li>
    ))}
  </ul>

  <a href="#conceito" class="hero-rolar" aria-label="Rolar para o conteúdo"><span></span></a>
</section>

<style>
  .hero { position: relative; min-height: 100svh; display: grid; grid-template-rows: 1fr auto; color: var(--areia); overflow: hidden; background: var(--verde-900); }
  .hero-midia { position: absolute; inset: 0; will-change: transform; }
  .hero-midia img, .hero-midia video { width: 100%; height: 100%; object-fit: cover; }
  .hero-veu { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(12,35,28,0.55) 0%, rgba(12,35,28,0.15) 35%, rgba(12,35,28,0.75) 100%); }
  .hero-conteudo { position: relative; align-self: end; padding-top: 140px; padding-bottom: 48px; }
  .hero-eyebrow { color: var(--ouro-claro); }
  .hero-titulo { font-size: clamp(2.9rem, 8.4vw, 7.6rem); max-width: 13ch; margin: 22px 0 26px; font-weight: 300; line-height: 0.98; }
  .hero-titulo :global(.split-w) { line-height: 0.98; }
  .hero-texto { max-width: 46ch; font-size: clamp(1.02rem, 1.5vw, 1.2rem); color: rgba(243,238,228,0.85); }
  .hero-acoes { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 34px; }
  .hero-numeros { position: relative; list-style: none; margin: 0 auto; padding-top: 28px; padding-bottom: 36px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; border-top: 1px solid rgba(243,238,228,0.2); }
  .hero-numeros li { display: grid; gap: 2px; }
  .hero-numeros strong { font-family: var(--serif); font-weight: 300; font-size: clamp(2rem, 4vw, 3.2rem); line-height: 1; color: var(--ouro-claro); }
  .hero-numeros li > span { font-size: 0.85rem; color: rgba(243,238,228,0.75); }
  .hero-rolar { position: absolute; right: var(--gutter); bottom: 40px; width: 26px; height: 42px; border: 1.5px solid rgba(243,238,228,0.6); border-radius: 20px; }
  .hero-rolar span { position: absolute; left: 50%; top: 8px; width: 3px; height: 8px; margin-left: -1.5px; border-radius: 2px; background: var(--areia); animation: rolar 1.8s var(--ease) infinite; }
  @keyframes rolar { 0% { transform: translateY(0); opacity: 1; } 70% { transform: translateY(14px); opacity: 0; } 100% { opacity: 0; } }
  @media (max-width: 720px) {
    .hero-numeros { grid-template-columns: 1fr 1fr 1fr; gap: 12px; }
    .hero-numeros li > span { font-size: 0.72rem; line-height: 1.3; }
    .hero-rolar { display: none; }
    .hero-acoes .botao { flex: 1 1 100%; }
  }
</style>
