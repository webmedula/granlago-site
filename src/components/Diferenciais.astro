---
import { diferenciais, assinaturas, site } from '../data/site';
import Foto from './Foto.astro';
import Icone from './Icone.astro';
const [infra, seguranca, lazerClube] = diferenciais;
---
<section class="dif secao" id="diferenciais">
  <div class="container">
    <h2 class="dif-titulo" data-reveal>Pensado para durar e valorizar</h2>

    <div class="bento">
      <article class="b b-foto" data-reveal>
        <Foto src={lazerClube.imagem} alt="" class="b-img" data-parallax="-6" />
        <div class="b-foto-txt">
          <h3>{lazerClube.titulo}</h3>
          <p>{lazerClube.texto}</p>
        </div>
      </article>
      <article class="b b-mata" data-reveal>
        <Icone nome="raio" class="b-ic" />
        <h3>{infra.titulo}</h3>
        <p>{infra.texto}</p>
      </article>
      <article class="b b-claro" data-reveal>
        <Icone nome="escudo" class="b-ic" />
        <h3>{seguranca.titulo}</h3>
        <p>{seguranca.texto}</p>
      </article>
    </div>

    <div class="assin" data-reveal>
      <p class="assin-intro">Assinado por</p>
      <ul>
        {assinaturas.map((a) => (
          <li><span>{a.papel}</span><strong>{a.nome}</strong></li>
        ))}
        <li><span>Realização</span><strong><a href={site.links.urbanizamos} target="_blank" rel="noopener">Urbanizamos</a></strong></li>
      </ul>
    </div>
  </div>
</section>

<style>
  .dif-titulo { max-width: 16ch; margin-bottom: clamp(40px, 5vw, 64px); }
  .bento { display: grid; grid-template-columns: 7fr 5fr; grid-template-rows: auto auto; gap: 16px; }
  .b { border-radius: var(--raio); padding: clamp(24px, 3vw, 36px); display: grid; gap: 10px; align-content: end; min-height: 260px; position: relative; overflow: hidden; }
  .b p { color: var(--fg-soft); max-width: 40ch; }
  .b :global(.b-ic) { width: 34px; height: 34px; margin-bottom: auto; }
  .b-foto { grid-row: 1 / 3; min-height: 560px; color: #fff; padding: 0; }
  .b-foto :global(.b-img) { position: absolute; inset: -6% 0; }
  .b-foto::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, transparent 40%, rgba(8,22,16,0.8)); }
  .b-foto-txt { position: relative; z-index: 1; padding: clamp(24px, 3vw, 36px); display: grid; gap: 10px; }
  .b-foto-txt p { color: rgba(255,255,255,0.85); }
  .b-mata { background: var(--mata); color: var(--mata-fg); align-content: stretch; }
  .b-mata p { color: color-mix(in srgb, var(--mata-fg) 78%, transparent); }
  .b-claro { background: var(--surface); align-content: stretch; box-shadow: 0 1px 0 var(--line); }
  .b-mata, .b-claro { grid-template-rows: 1fr auto auto; }

  .assin { margin-top: clamp(72px, 9vw, 120px); display: grid; grid-template-columns: 1fr 3fr; gap: 24px; align-items: start; }
  .assin-intro { font-family: var(--display); font-size: 1.4rem; letter-spacing: -0.02em; }
  .assin ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .assin li { display: grid; gap: 4px; padding-left: 20px; border-left: 1px solid var(--line); }
  .assin li span { font-size: 0.85rem; color: var(--fg-soft); }
  .assin li strong { font-family: var(--display); font-weight: 500; font-size: 1.25rem; letter-spacing: -0.02em; }
  .assin a { text-decoration: none; }
  .assin a:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .bento { grid-template-columns: 1fr; }
    .b-foto { grid-row: auto; min-height: 420px; }
    .assin { grid-template-columns: 1fr; }
    .assin ul { grid-template-columns: 1fr; gap: 16px; }
  }
</style>
