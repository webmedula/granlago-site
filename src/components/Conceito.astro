---
import Foto from './Foto.astro';
---
<section class="conceito secao" id="conceito">
  <div class="container">
    <p class="manifesto" data-palavras>
      Um ambiente cercado pela natureza, onde a tranquilidade e o conforto se encontram. O lago é o ponto de partida: praças, caminhos e lazer foram desenhados ao redor da água e do verde.
    </p>
  </div>
  <div class="conceito-fotos container">
    <Foto src="/img/conceito-1.webp" alt="Perspectiva ilustrativa do lago" class="cf cf-1" data-parallax="-12" />
    <Foto src="/img/conceito-2.webp" alt="Perspectiva ilustrativa do paisagismo" class="cf cf-2" data-parallax="10" />
    <Foto src="/img/conceito-3.webp" alt="Perspectiva ilustrativa das áreas de convivência" class="cf cf-3" data-parallax="-6" />
  </div>
</section>

<style>
  .manifesto { font-family: var(--display); font-weight: 300; font-size: clamp(1.8rem, 4.2vw, 3.6rem); line-height: 1.12; letter-spacing: -0.035em; max-width: 22ch; }
  .manifesto :global(.palavra) { opacity: 0.16; }
  :global(html:not(.js-anim)) .manifesto :global(.palavra) { opacity: 1; }
  .conceito-fotos { display: grid; grid-template-columns: repeat(12, 1fr); gap: 20px; margin-top: clamp(64px, 9vw, 120px); align-items: start; }
  .conceito-fotos :global(.cf) { border-radius: var(--raio); }
  .conceito-fotos :global(.cf-1) { grid-column: 1 / 7; aspect-ratio: 4 / 5; }
  .conceito-fotos :global(.cf-2) { grid-column: 8 / 13; aspect-ratio: 1; margin-top: 18%; }
  .conceito-fotos :global(.cf-3) { grid-column: 5 / 10; aspect-ratio: 16 / 10; margin-top: -10%; }
  @media (max-width: 767px) {
    .conceito-fotos { grid-template-columns: 1fr; gap: 14px; }
    .conceito-fotos :global(.cf-1), .conceito-fotos :global(.cf-2), .conceito-fotos :global(.cf-3) { grid-column: 1; margin-top: 0; }
    .conceito-fotos :global(.cf-2), .conceito-fotos :global(.cf-3) { display: none; }
  }
</style>
